<Window
    x:Class="FamVault.App.UI.Views.SaveFamilyDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FamVault - Save Families"
    Width="700"
    Height="680"
    MinWidth="550"
    MinHeight="480"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource WindowBackground}"
    Foreground="{DynamicResource PrimaryText}"
    FontFamily="Segoe UI"
    FontSize="13">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="/FamVault.App;component/UI/Resources/FamVaultStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid
        Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid
            Grid.Row="0"
            Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="*" />
                <ColumnDefinition
                    Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock
                    Text="Save Families"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource PrimaryText}" />

                <TextBlock
                    Text="Select families and add comments."
                    Margin="0,5,0,0"
                    Foreground="{DynamicResource SecondaryText}" />
            </StackPanel>

            <Border
                Grid.Column="1"
                Background="#293B34"
                CornerRadius="6"
                Padding="12,6"
                VerticalAlignment="Center">
                <TextBlock
                    Text="LOCAL"
                    Foreground="#8AD2AE"
                    FontWeight="SemiBold" />
            </Border>
        </Grid>

        <!-- SELECTION -->
        <DockPanel
            Grid.Row="1"
            Margin="0,0,0,12">
            <TextBlock
                Text="Selected Revit Families"
                FontWeight="SemiBold"
                Foreground="{DynamicResource PrimaryText}" />

            <TextBlock
                x:Name="SelectionSummary"
                DockPanel.Dock="Right"
                Foreground="{DynamicResource SecondaryText}"
                HorizontalAlignment="Right" />
        </DockPanel>

        <!-- FAMILY LIST -->
        <ScrollViewer
            Grid.Row="2"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <ItemsControl
                ItemsSource="{Binding Families}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource FamVaultBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="14"
                            Margin="0,0,0,9">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition
                                        Height="Auto" />
                                    <RowDefinition
                                        Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid
                                    Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition
                                            Width="30" />
                                        <ColumnDefinition
                                            Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource FamVaultCheckBox}"
                                        IsChecked="{Binding IsSelected,
                                                          Mode=TwoWay}" />

                                    <StackPanel
                                        Grid.Column="1">
                                        <TextBlock
                                            Text="{Binding Name}"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource PrimaryText}" />

                                        <TextBlock
                                            Text="{Binding Category}"
                                            FontSize="11"
                                            Margin="0,4,0,0"
                                            Foreground="{DynamicResource SecondaryText}" />
                                    </StackPanel>
                                </Grid>

                                <!-- INDIVIDUAL COMMENT -->
                                <TextBox
                                    Grid.Row="1"
                                    Margin="30,12,0,0"
                                    Style="{StaticResource FamVaultCommentTextBox}"
                                    Text="{Binding Comment,
                                                UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="Individual family comment" />

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- COMMON COMMENT -->
        <Border
            Grid.Row="3"
            Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource FamVaultBorderBrush}"
            BorderThickness="1"
            CornerRadius="7"
            Padding="14"
            Margin="0,12,0,0">

            <StackPanel>
                <TextBlock
                    Text="Common Comment"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource PrimaryText}" />

                <TextBlock
                    Text="Apply the same comment to all selected families."
                    FontSize="11"
                    Foreground="{DynamicResource SecondaryText}"
                    Margin="0,5,0,10" />

                <TextBox
                    x:Name="CommonCommentTextBox"
                    Style="{StaticResource FamVaultCommentTextBox}"
                    MinHeight="60" />

                <Button
                    Content="Apply to Selected"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0"
                    Style="{StaticResource FamVaultSecondaryButton}"
                    Click="ApplyCommonComment_Click" />
            </StackPanel>
        </Border>

        <!-- FOOTER -->
        <Grid
            Grid.Row="4"
            Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="*" />
                <ColumnDefinition
                    Width="Auto" />
                <ColumnDefinition
                    Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                x:Name="FooterSummary"
                VerticalAlignment="Center"
                Foreground="{DynamicResource SecondaryText}" />

            <Button
                Grid.Column="1"
                Content="Cancel"
                Width="110"
                Margin="0,0,8,0"
                Style="{StaticResource FamVaultSecondaryButton}"
                Click="Cancel_Click" />

            <Button
                Grid.Column="2"
                Content="Save Selected"
                MinWidth="135"
                Style="{StaticResource FamVaultButton}"
                Click="Save_Click" />
        </Grid>

    </Grid>
</Window>
