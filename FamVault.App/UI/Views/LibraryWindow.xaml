<Window
    x:Class="FamVault.App.UI.Views.LibraryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FamVault - Family Library"
    Width="1050"
    Height="720"
    MinWidth="820"
    MinHeight="500"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource WindowBackground}"
    Foreground="{DynamicResource PrimaryText}"
    FontFamily="Segoe UI"
    FontSize="13">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="/FamVault.App;component/UI/Resources/FamVaultStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid
        Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid
            Grid.Row="0"
            Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="*" />
                <ColumnDefinition
                    Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock
                    Text="FamVault"
                    FontSize="26"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource PrimaryText}" />

                <TextBlock
                    Text="Family Library · Local Storage"
                    Margin="0,5,0,0"
                    Foreground="{DynamicResource SecondaryText}" />
            </StackPanel>

            <Button
                Content="Trash"
                Width="100"
                Margin="0,0,12,0"
                Style="{StaticResource FamVaultSecondaryButton}"
                Click="OpenTrash_Click" />

            <Border
                Grid.Column="1"
                Background="#293B34"
                CornerRadius="6"
                Padding="14,7"
                VerticalAlignment="Center">
                <TextBlock
                    Text="LOCAL"
                    Foreground="#8AD2AE"
                    FontWeight="SemiBold" />
            </Border>
        </Grid>

        <!-- TOOLBAR -->
        <Grid
            Grid.Row="1"
            Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="*" />
                <ColumnDefinition
                    Width="Auto" />
                <ColumnDefinition
                    Width="Auto" />
                <ColumnDefinition
                    Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                Grid.Column="0"
                Height="36"
                Style="{StaticResource FamVaultTextBox}"
                Text="{Binding SearchText,
                                    UpdateSourceTrigger=PropertyChanged}"
                ToolTip="Search families, categories and comments" />

            <Button
                Grid.Column="1"
                Content="Refresh"
                Margin="8,0,0,0"
                Style="{StaticResource FamVaultSecondaryButton}"
                Click="Refresh_Click" />

            <Button
                Grid.Column="2"
                Content="Expand All"
                Margin="8,0,0,0"
                Style="{StaticResource FamVaultSecondaryButton}"
                Click="ExpandAll_Click" />

            <Button
                Grid.Column="3"
                Content="Collapse All"
                Margin="8,0,0,0"
                Style="{StaticResource FamVaultSecondaryButton}"
                Click="CollapseAll_Click" />
        </Grid>

        <!-- LIBRARY CONTENT -->
        <Grid
            Grid.Row="2">

            <ScrollViewer
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">

                <ItemsControl
                    ItemsSource="{Binding VersionGroups}">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <!-- REVIT VERSION -->
                            <Expander
                                Style="{StaticResource FamVaultExpander}"
                                IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                Margin="0,0,0,12">

                                <Expander.Header>
                                    <StackPanel
                                        Orientation="Horizontal">
                                        <TextBlock
                                            Text="{Binding Title}"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource PrimaryText}" />

                                        <TextBlock
                                            Text="{Binding Summary}"
                                            Margin="18,2,0,0"
                                            Foreground="{DynamicResource SecondaryText}" />
                                    </StackPanel>
                                </Expander.Header>

                                <!-- FAMILY COLLECTION -->
                                <ItemsControl
                                    ItemsSource="{Binding Families}"
                                    Margin="8,10">


                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>

                                            <Border
                                                Background="{DynamicResource CardBackground}"
                                                BorderBrush="{DynamicResource FamVaultBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="7"
                                                Margin="0,0,0,8"
                                                Padding="12">

                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition
                                                            Height="Auto" />
                                                        <RowDefinition
                                                            Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition
                                                            Width="32" />
                                                        <ColumnDefinition
                                                            Width="28" />
                                                        <ColumnDefinition
                                                            Width="*" />
                                                        <ColumnDefinition
                                                            Width="150" />
                                                        <ColumnDefinition
                                                            Width="90" />
                                                        <ColumnDefinition
                                                            Width="42" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- FAMILY SELECTION -->
                                                    <CheckBox
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center"
                                                        Style="{StaticResource FamVaultCheckBox}"
                                                        IsChecked="{Binding IsSelected, Mode=TwoWay}" />

                                                    <!-- EXPAND / COLLAPSE -->
                                                    <ToggleButton
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        Width="24"
                                                        Height="28"
                                                        VerticalAlignment="Center"
                                                        Cursor="Hand"
                                                        IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                        Style="{StaticResource FamVaultExpandToggle}">

                                                        <ToggleButton.Template>
                                                            <ControlTemplate
                                                                TargetType="ToggleButton">
                                                                <Border
                                                                    Background="Transparent">
                                                                    <Path
                                                                        x:Name="Arrow"
                                                                        Data="M 2,5 L 7,10 L 12,5"
                                                                        Stroke="{DynamicResource SecondaryText}"
                                                                        StrokeThickness="1.8"
                                                                        StrokeStartLineCap="Round"
                                                                        StrokeEndLineCap="Round"
                                                                        Width="14"
                                                                        Height="14"
                                                                        Stretch="Uniform"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center">
                                                                        <Path.RenderTransform>
                                                                            <RotateTransform
                                                                                Angle="-90"
                                                                                CenterX="7"
                                                                                CenterY="7" />
                                                                        </Path.RenderTransform>
                                                                    </Path>
                                                                </Border>

                                                                <ControlTemplate.Triggers>
                                                                    <Trigger
                                                                        Property="IsChecked"
                                                                        Value="True">
                                                                        <Setter
                                                                            TargetName="Arrow"
                                                                            Property="RenderTransform">
                                                                            <Setter.Value>
                                                                                <RotateTransform
                                                                                    Angle="0"
                                                                                    CenterX="7"
                                                                                    CenterY="7" />
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                    </ToggleButton>
                                                    <!-- FAMILY INFORMATION WITH PREVIEW -->
                                                    <Grid
                                                        Grid.Row="0"
                                                        Grid.Column="2"
                                                        Margin="6,0,10,0">

                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition
                                                                Width="72" />
                                                            <ColumnDefinition
                                                                Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- PREVIEW -->
                                                        <Border
                                                            Grid.Column="0"
                                                            Width="64"
                                                            Height="64"
                                                            Background="{DynamicResource HeaderBackground}"
                                                            BorderBrush="{DynamicResource FamVaultBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            ClipToBounds="True">

                                                            <Image
                                                                Source="{Binding SelectedRevision.Preview}"
                                                                Stretch="Uniform"
                                                                Margin="4" />
                                                        </Border>

                                                        <!-- FAMILY INFORMATION -->
                                                        <StackPanel
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Margin="8,0,0,0">

                                                            <TextBlock
                                                                Text="{Binding Name}"
                                                                FontWeight="SemiBold"
                                                                Foreground="{DynamicResource PrimaryText}" />

                                                            <TextBlock
                                                                Text="{Binding Category}"
                                                                FontSize="11"
                                                                Margin="0,4,0,0"
                                                                Foreground="{DynamicResource SecondaryText}" />

                                                        </StackPanel>
                                                    </Grid>
                                                    <!-- SELECT REVISION -->
                                                    <ComboBox
                                                        Grid.Row="0"
                                                        Grid.Column="3"
                                                        Height="34"
                                                        Margin="5,0"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource FamVaultComboBox}"
                                                        ItemsSource="{Binding Revisions}"
                                                        SelectedItem="{Binding SelectedRevision, Mode=TwoWay}"
                                                        DisplayMemberPath="RevisionDisplay" />

                                                    <!-- FAMILY SIZE -->
                                                    <TextBlock
                                                        Grid.Row="0"
                                                        Grid.Column="4"
                                                        Text="{Binding SizeDisplay}"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Right"
                                                        Margin="8,0"
                                                        Foreground="{DynamicResource SecondaryText}" />

                                                    <!-- DELETE FAMILY -->
                                                    <Button
                                                        Grid.Row="0"
                                                        Grid.Column="5"
                                                        Width="34"
                                                        MinWidth="34"
                                                        Height="32"
                                                        Padding="0"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource FamVaultSecondaryButton}"
                                                        ToolTip="Delete family and all revisions"
                                                        Click="DeleteFamily_Click">

                                                        <Path
                                                            Data="M 4,5 L 16,5
                              M 7,5 L 7,3 L 13,3 L 13,5
                              M 6,7 L 7,18 L 13,18 L 14,7
                              M 9,9 L 9,16
                              M 11,9 L 11,16"
                                                            Stroke="{DynamicResource DangerBrush}"
                                                            StrokeThickness="1.5"
                                                            StrokeStartLineCap="Round"
                                                            StrokeEndLineCap="Round"
                                                            Width="18"
                                                            Height="18"
                                                            Stretch="Uniform" />
                                                    </Button>

                                                    <!-- REVISION HISTORY -->
                                                    <Border
                                                        Grid.Row="1"
                                                        Grid.Column="0"
                                                        Grid.ColumnSpan="6"
                                                        Margin="0,12,0,0"
                                                        Padding="0,12,0,0"
                                                        BorderThickness="0,1,0,0"
                                                        BorderBrush="{DynamicResource FamVaultBorderBrush}"
                                                        Visibility="{Binding IsExpanded,
                        Converter={StaticResource BooleanToVisibilityConverter}}">

                                                        <ItemsControl
                                                            ItemsSource="{Binding Revisions}">

                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>

                                                                    <Border
                                                                        Background="{DynamicResource HeaderBackground}"
                                                                        CornerRadius="5"
                                                                        Padding="12,10"
                                                                        Margin="0,0,0,5">

                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition
                                                                                    Width="*" />
                                                                                <ColumnDefinition
                                                                                    Width="Auto" />
                                                                            </Grid.ColumnDefinitions>

                                                                            <!-- REVISION DETAILS -->
                                                                            <StackPanel
                                                                                Grid.Column="0"
                                                                                VerticalAlignment="Center">

                                                                                <TextBlock
                                                                                    Text="{Binding RevisionDisplay}"
                                                                                    FontWeight="SemiBold"
                                                                                    Foreground="{DynamicResource PrimaryText}" />

                                                                                <StackPanel
                                                                                    Orientation="Horizontal"
                                                                                    Margin="0,4,0,0">

                                                                                    <TextBlock
                                                                                        Text="{Binding DateDisplay}"
                                                                                        FontSize="11"
                                                                                        Foreground="{DynamicResource SecondaryText}" />

                                                                                    <TextBlock
                                                                                        Text="{Binding SizeDisplay}"
                                                                                        FontSize="11"
                                                                                        Margin="16,0,0,0"
                                                                                        Foreground="{DynamicResource SecondaryText}" />
                                                                                </StackPanel>

                                                                                <TextBlock
                                                                                    Text="{Binding Comment}"
                                                                                    TextWrapping="Wrap"
                                                                                    Margin="0,6,0,0"
                                                                                    Foreground="{DynamicResource SecondaryText}" />
                                                                            </StackPanel>

                                                                            <!-- REVISION ACTIONS -->
                                                                            <Button
                                                                                Grid.Column="1"
                                                                                Width="34"
                                                                                MinWidth="34"
                                                                                Height="32"
                                                                                Padding="0"
                                                                                VerticalAlignment="Center"
                                                                                Style="{StaticResource FamVaultSecondaryButton}"
                                                                                ToolTip="Revision actions"
                                                                                Click="OpenActionsMenu_Click">

                                                                                <TextBlock
                                                                                    Text="⋯"
                                                                                    FontSize="20"
                                                                                    FontWeight="Bold"
                                                                                    Foreground="{DynamicResource PrimaryText}"
                                                                                    HorizontalAlignment="Center"
                                                                                    VerticalAlignment="Center" />

                                                                                <Button.ContextMenu>
                                                                                    <ContextMenu
                                                                                        Style="{StaticResource FamVaultContextMenu}"
                                                                                        DataContext="{Binding PlacementTarget.DataContext,
            RelativeSource={RelativeSource Self}}">

                                                                                        <MenuItem
                                                                                            Header="Edit Comment"
                                                                                            Style="{StaticResource FamVaultMenuItem}"
                                                                                            CommandParameter="{Binding}"
                                                                                            Click="EditRevisionComment_Click">

                                                                                            <MenuItem.Icon>
                                                                                                <Path
                                                                                                    Data="M 3,14 L 3,18 L 7,18
                          L 17,8 L 13,4 Z
                          M 11,6 L 15,10"
                                                                                                    Stroke="{DynamicResource PrimaryText}"
                                                                                                    StrokeThickness="1.5"
                                                                                                    StrokeLineJoin="Round"
                                                                                                    Width="18"
                                                                                                    Height="18"
                                                                                                    Stretch="Uniform" />
                                                                                            </MenuItem.Icon>

                                                                                        </MenuItem>

                                                                                        <MenuItem
                                                                                            Header="Delete Revision"
                                                                                            Style="{StaticResource FamVaultMenuItem}"
                                                                                            CommandParameter="{Binding}"
                                                                                            Click="DeleteRevision_Click">

                                                                                            <MenuItem.Icon>
                                                                                                <Path
                                                                                                    Data="M 4,5 L 16,5
                          M 7,5 L 7,3 L 13,3 L 13,5
                          M 6,7 L 7,18 L 13,18 L 14,7
                          M 9,9 L 9,16
                          M 11,9 L 11,16"
                                                                                                    Stroke="{DynamicResource DangerBrush}"
                                                                                                    StrokeThickness="1.5"
                                                                                                    StrokeStartLineCap="Round"
                                                                                                    StrokeEndLineCap="Round"
                                                                                                    StrokeLineJoin="Round"
                                                                                                    Width="18"
                                                                                                    Height="18"
                                                                                                    Stretch="Uniform" />
                                                                                            </MenuItem.Icon>

                                                                                        </MenuItem>

                                                                                    </ContextMenu>
                                                                                </Button.ContextMenu>

                                                                            </Button>
                                                                        </Grid>
                                                                    </Border>

                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>

                                                        </ItemsControl>
                                                    </Border>

                                                </Grid>
                                            </Border>

                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>
            </ScrollViewer>

            <!-- LOADING OVERLAY -->
            <Border
                Background="#DD171B20"
                Visibility="{Binding IsLoading,
                    Converter={StaticResource BooleanToVisibilityConverter}}">

                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                    <ProgressBar
                        Width="240"
                        Height="6"
                        IsIndeterminate="True" />

                    <TextBlock
                        Text="Loading family library..."
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource PrimaryText}"
                        Margin="0,15,0,12" />

                    <Button
                        Content="Cancel"
                        Width="110"
                        Style="{StaticResource FamVaultSecondaryButton}"
                        Click="CancelLoading_Click" />

                </StackPanel>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <Grid
            Grid.Row="3"
            Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="*" />
                <ColumnDefinition
                    Width="Auto" />
                <ColumnDefinition
                    Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center">

                <TextBlock
                    Text="{Binding StatusText}"
                    Foreground="{DynamicResource SecondaryText}" />

                <TextBlock
                    Text="{Binding ErrorMessage}"
                    Foreground="{DynamicResource DangerBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Button
                Grid.Column="1"
                Content="Close"
                Width="110"
                Margin="0,0,8,0"
                Style="{StaticResource FamVaultSecondaryButton}"
                Click="Close_Click" />

            <Button
                Grid.Column="2"
                Content="Load Selected"
                MinWidth="135"
                Style="{StaticResource FamVaultButton}"
                Click="LoadSelected_Click" />

        </Grid>
    </Grid>
</Window>
