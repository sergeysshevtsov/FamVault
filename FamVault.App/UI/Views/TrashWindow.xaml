<Window
    x:Class="FamVault.App.UI.Views.TrashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FamVault - Trash Manager"
    Width="850"
    Height="620"
    MinWidth="650"
    MinHeight="450"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource WindowBackground}"
    Foreground="{DynamicResource PrimaryText}"
    FontFamily="Segoe UI"
    FontSize="13">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="/FamVault.App;component/UI/Resources/FamVaultStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid
        Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,20">
            <TextBlock
                Text="Trash Manager"
                FontSize="24"
                FontWeight="SemiBold"
                Foreground="{DynamicResource PrimaryText}" />

            <TextBlock
                Text="Restore deleted families and revisions."
                Margin="0,5,0,0"
                Foreground="{DynamicResource SecondaryText}" />
        </StackPanel>

        <!-- TOOLBAR -->
        <Grid
            Grid.Row="1"
            Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="*" />
                <ColumnDefinition
                    Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="SearchTextBox"
                Grid.Column="0"
                Style="{StaticResource FamVaultTextBox}"
                TextChanged="SearchTextBox_TextChanged" />

            <Button
                Grid.Column="1"
                Content="Refresh"
                Margin="8,0,0,0"
                Style="{StaticResource FamVaultSecondaryButton}"
                Click="Refresh_Click" />
        </Grid>

        <!-- TRASH CONTENT -->
        <Grid
            Grid.Row="2">
            <ScrollViewer
                VerticalScrollBarVisibility="Auto">

                <ItemsControl
                    x:Name="TrashItemsControl">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <Border
                                Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource FamVaultBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="12"
                                Margin="0,0,0,10">

                                <StackPanel>

                                    <!-- DELETED FAMILY HEADER -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition
                                                Width="28" />
                                            <ColumnDefinition
                                                Width="72" />
                                            <ColumnDefinition
                                                Width="*" />
                                            <ColumnDefinition
                                                Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ToggleButton
                                            Grid.Column="0"
                                            Style="{StaticResource FamVaultExpandToggle}"
                                            IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                            VerticalAlignment="Center">

                                            <ToggleButton.Template>
                                                <ControlTemplate
                                                    TargetType="ToggleButton">
                                                    <Border
                                                        Background="Transparent">
                                                        <Path
                                                            x:Name="Arrow"
                                                            Data="M 2,5 L 7,10 L 12,5"
                                                            Stroke="{DynamicResource SecondaryText}"
                                                            StrokeThickness="1.8"
                                                            StrokeStartLineCap="Round"
                                                            StrokeEndLineCap="Round"
                                                            Width="14"
                                                            Height="14"
                                                            Stretch="Uniform"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                            <Path.RenderTransform>
                                                                <RotateTransform
                                                                    Angle="-90"
                                                                    CenterX="7"
                                                                    CenterY="7" />
                                                            </Path.RenderTransform>
                                                        </Path>
                                                    </Border>

                                                    <ControlTemplate.Triggers>
                                                        <Trigger
                                                            Property="IsChecked"
                                                            Value="True">
                                                            <Setter
                                                                TargetName="Arrow"
                                                                Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <RotateTransform
                                                                        Angle="0"
                                                                        CenterX="7"
                                                                        CenterY="7" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>

                                        <!-- PREVIEW -->
                                        <Border
                                            Grid.Column="1"
                                            Width="64"
                                            Height="64"
                                            CornerRadius="6"
                                            Background="{DynamicResource HeaderBackground}"
                                            BorderBrush="{DynamicResource FamVaultBorderBrush}"
                                            BorderThickness="1"
                                            ClipToBounds="True">

                                            <Image
                                                Source="{Binding Preview}"
                                                Stretch="Uniform"
                                                Margin="4" />
                                        </Border>

                                        <!-- NAME -->
                                        <StackPanel
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Margin="10,0">

                                            <TextBlock
                                                Text="{Binding FamilyName}"
                                                FontWeight="SemiBold"
                                                FontSize="14"
                                                Foreground="{DynamicResource PrimaryText}" />

                                            <TextBlock
                                                Text="{Binding Summary}"
                                                FontSize="11"
                                                Margin="0,5,0,0"
                                                Foreground="{DynamicResource SecondaryText}" />
                                        </StackPanel>

                                        <!-- RESTORE ALL -->
                                        <Button
                                            Grid.Column="3"
                                            Content="Restore All"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource FamVaultButton}"
                                            Visibility="{Binding CanRestoreAll,
                                Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Click="RestoreGroup_Click" />

                                    </Grid>

                                    <!-- REVISIONS -->
                                    <Border
                                        Margin="0,12,0,0"
                                        BorderBrush="{DynamicResource FamVaultBorderBrush}"
                                        BorderThickness="0,1,0,0"
                                        Padding="0,12,0,0"
                                        Visibility="{Binding IsExpanded,
                            Converter={StaticResource BooleanToVisibilityConverter}}">

                                        <ItemsControl
                                            ItemsSource="{Binding Revisions}">

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>

                                                    <Border
                                                        Background="{DynamicResource HeaderBackground}"
                                                        CornerRadius="5"
                                                        Padding="12"
                                                        Margin="0,0,0,6">

                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition
                                                                    Width="*" />
                                                                <ColumnDefinition
                                                                    Width="Auto" />
                                                                <ColumnDefinition
                                                                    Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel
                                                                Grid.Column="0">

                                                                <TextBlock
                                                                    Text="{Binding RevisionDisplay}"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{DynamicResource PrimaryText}" />

                                                                <TextBlock
                                                                    Text="{Binding DeletedDisplay}"
                                                                    Margin="0,4,0,0"
                                                                    FontSize="11"
                                                                    Foreground="{DynamicResource SecondaryText}" />

                                                                <TextBlock
                                                                    Text="{Binding Comment}"
                                                                    Margin="0,5,0,0"
                                                                    TextWrapping="Wrap"
                                                                    Foreground="{DynamicResource SecondaryText}" />
                                                            </StackPanel>

                                                            <Button
                                                                Grid.Column="1"
                                                                Content="Restore"
                                                                Margin="8,0"
                                                                VerticalAlignment="Center"
                                                                Style="{StaticResource FamVaultSecondaryButton}"
                                                                Click="RestoreRevision_Click" />

                                                            <Button
                                                                Grid.Column="2"
                                                                Width="34"
                                                                MinWidth="34"
                                                                Height="34"
                                                                Padding="0"
                                                                VerticalAlignment="Center"
                                                                ToolTip="Delete permanently"
                                                                Style="{StaticResource FamVaultSecondaryButton}"
                                                                Click="DeletePermanently_Click">

                                                                <Path
                                                                    Data="M 4,5 L 16,5
                                                          M 7,5 L 7,3 L 13,3 L 13,5
                                                          M 6,7 L 7,18 L 13,18 L 14,7
                                                          M 9,9 L 9,16
                                                          M 11,9 L 11,16"
                                                                    Stroke="{DynamicResource DangerBrush}"
                                                                    StrokeThickness="1.5"
                                                                    StrokeStartLineCap="Round"
                                                                    StrokeEndLineCap="Round"
                                                                    StrokeLineJoin="Round"
                                                                    Width="18"
                                                                    Height="18"
                                                                    Stretch="Uniform" />
                                                            </Button>

                                                        </Grid>
                                                    </Border>

                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>

                                        </ItemsControl>
                                    </Border>

                                </StackPanel>
                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>

            <Border
                x:Name="LoadingOverlay"
                Background="#DD171B20"
                Visibility="Collapsed">

                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                    <ProgressBar
                        Width="220"
                        Height="6"
                        IsIndeterminate="True" />

                    <TextBlock
                        Text="Processing Trash..."
                        Margin="0,12,0,0"
                        Foreground="{DynamicResource PrimaryText}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- FOOTER -->

        <Grid
            Grid.Row="3"
            Margin="0,16,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="*" />
                <ColumnDefinition
                    Width="Auto" />
                <ColumnDefinition
                    Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="StatusTextBlock"
                Grid.Column="0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource SecondaryText}" />

            <Button
                Grid.Column="1"
                Content="Empty Trash"
                Margin="0,0,10,0"
                Style="{StaticResource FamVaultSecondaryButton}"
                Foreground="{DynamicResource DangerBrush}"
                Click="EmptyTrash_Click" />

            <Button
                Grid.Column="2"
                Content="Close"
                Width="100"
                Style="{StaticResource FamVaultSecondaryButton}"
                Click="Close_Click" />

        </Grid>

    </Grid>
</Window>
