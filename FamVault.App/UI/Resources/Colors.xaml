<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="WindowBackground" Color="#171B20"/>
    <SolidColorBrush x:Key="CardBackground" Color="#222831"/>
    <SolidColorBrush x:Key="HeaderBackground" Color="#2C333D"/>
    <SolidColorBrush x:Key="HoverBackground" Color="#353D48"/>
    <SolidColorBrush x:Key="SelectedBackground" Color="#3C4654"/>

    <!-- Typography -->
    <SolidColorBrush x:Key="PrimaryText" Color="#F0F2F5"/>
    <SolidColorBrush x:Key="SecondaryText" Color="#A4AFBB"/>
    <SolidColorBrush x:Key="DisabledText" Color="#737F8D"/>

    <!-- Controls -->
    <SolidColorBrush x:Key="AccentBrush" Color="#586474"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6B7889"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#46515F"/>
    <SolidColorBrush x:Key="FamVaultBorderBrush" Color="#3C4551"/>

    <!-- Status -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#59A785"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#D16C70"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#D6AA63"/>

</ResourceDictionary>
